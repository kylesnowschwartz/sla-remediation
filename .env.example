# owner/name of the GitHub fork whose findings the service files and fixes
SLA_REPO=
# GitHub token with write access to contents, issues, and pull requests on that fork
SLA_GITHUB_TOKEN=
# shared secret configured on the fork's webhook; every delivery must be signed with it
SLA_WEBHOOK_SECRET=
# Devin API v3 service-user key (a personal key does not work) used to create and poll sessions
DEVIN_SERVICE_API_KEY_V3=
# Devin organization ID that sessions are created under
DEVIN_ORG_ID=
# set to true so a labelled issue starts a Devin session automatically; leave unset to only record findings
SLA_AUTO_DISPATCH=
# smee.io channel URL that the fork's webhook points at
SMEE_URL=
